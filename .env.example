POSTGRES_DB=leadgensystem
POSTGRES_USER=leadgensystem
POSTGRES_PASSWORD=change_me
# Inside Docker Compose, host must be "db". On the VPS this stays as-is.
DATABASE_URL=postgresql://leadgensystem:change_me@db:5432/leadgensystem
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change_me
SECRET_KEY=replace_with_long_random_string
# No domain yet: use http://YOUR_VPS_IP:8080 (unsubscribe service).
# With a domain later: https://your.domain.com
BASE_URL=http://localhost:8080
DEFAULT_REGION=PK
# Optional — only for Caddy prod profile
# DOMAIN=your.domain.com
